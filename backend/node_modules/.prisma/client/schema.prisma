generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  mobile       String?
  passwordHash String
  role         String   @default("CONSUMER") // CONSUMER, MANUFACTURER, STUDENT, ADMIN
  language     String   @default("en") // en, hi, te, ta, kn, bn
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations      Conversation[]
  documents          Document[]
  complianceProjects ComplianceProject[]
  savedItems         SavedItem[]
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("New BIS Consultation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id                String   @id @default(uuid())
  conversationId    String
  role              String // user, assistant, system
  content           String
  sources           String? // JSON string of sources/citations
  relatedQuestions  String? // JSON array of follow-up suggestions
  recommendedAction String? // Next step guidance
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Standard {
  id                  String   @id @default(uuid())
  standardNumber      String   @unique // e.g. IS 302-2-15
  title               String
  category            String // Electrical, Electronics, Mechanical, Food, Jewelry, etc.
  description         String
  scope               String
  status              String   @default("ACTIVE") // ACTIVE, REVISED, DRAFT
  version             String   @default("2024")
  isMandatory         Boolean  @default(true)
  qcoDate             String? // Gazette / QCO enforcement date
  certificationScheme String   @default("Scheme I (ISI Mark)") // Scheme I, Scheme II (CRS), Hallmarking
  testingRequirements String? // Summary of primary tests required
  sourceUrl           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clauses StandardClause[]
}

model StandardClause {
  id           String @id @default(uuid())
  standardId   String
  clauseNumber String // e.g. "8.1", "19.1"
  title        String
  content      String
  pageNumber   Int?

  standard Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
}

model Document {
  id            String   @id @default(uuid())
  userId        String?
  name          String
  fileType      String
  fileSize      Int
  storagePath   String
  status        String   @default("PROCESSED") // UPLOADING, PROCESSING, PROCESSED, ERROR
  extractedText String?
  summary       String? // AI summary JSON string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String  @id @default(uuid())
  documentId String
  pageNumber Int?
  clause     String?
  content    String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Laboratory {
  id               String   @id @default(uuid())
  name             String
  location         String // City
  state            String
  capabilities     String // Mechanical, Electrical, Chemical, Biological, etc.
  standardsCovered String // Comma-separated or JSON of IS standards
  contactEmail     String?
  contactPhone     String?
  address          String
  isRecommended    Boolean  @default(false)
  isNablAccredited Boolean  @default(true)
  isBisRecognized  Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model ComplianceProject {
  id                 String   @id @default(uuid())
  userId             String
  product            String
  standardNumber     String
  standardTitle      String?
  score              Int      @default(65)
  status             String   @default("IN_PROGRESS") // IN_PROGRESS, READY, REVIEW_NEEDED
  readinessBreakdown String? // JSON breakdown
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks ComplianceTask[]
}

model ComplianceTask {
  id        String  @id @default(uuid())
  projectId String
  title     String
  category  String // IDENTIFY, DISCOVER, UNDERSTAND, TEST, CERTIFY, COMPLY
  status    String  @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  priority  String  @default("MEDIUM") // HIGH, MEDIUM, LOW
  dueDate   String?
  notes     String?

  project ComplianceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  content     String
  type        String   @default("QCO_UPDATE") // QCO_UPDATE, STANDARD_REVISION, SYSTEM, REMINDER
  category    String   @default("Gazette Notification")
  isUrgent    Boolean  @default(false)
  publishedAt DateTime @default(now())
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  itemType  String // STANDARD, LAB, DOCUMENT, ROADMAP
  itemId    String
  title     String
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductVerification {
  id               String   @id @default(uuid())
  licenceNumber    String   @unique // e.g. CM/L-1234567 or R-41000000 or HUID
  brand            String
  manufacturer     String
  model            String
  standardNumber   String
  productCategory  String
  status           String   @default("OPERATIVE") // OPERATIVE, SUSPENDED, EXPIRED, CANCELLED
  validUntil       String
  verificationType String   @default("ISI_MARK") // ISI_MARK, CRS_REGISTRATION, HALLMARK_HUID
  factoryLocation  String?
  createdAt        DateTime @default(now())
}
