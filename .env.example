# =================================================================
# SolveX - AI-Powered BIS Standards & Compliance Assistant
# Environment Configuration Template
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security & JWT Authentication
JWT_SECRET=solvex-super-secure-jwt-secret-sih2026-key
JWT_EXPIRES_IN=7d

# Database Connection
# Default for development is SQLite (zero-setup local execution):
DATABASE_URL="file:./dev.db"
# For Production PostgreSQL (e.g. Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://user:password@localhost:5432/solvex?schema=public"

# AI Provider Configurations (Optional - Built-in BIS Intelligence Engine works out-of-the-box)
# Google Gemini API Key
GEMINI_API_KEY=
# OpenAI API Key (or OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
